BMKG_API_KEY=replace-with-bmkg-api-key
PVMBG_TOKEN=replace-with-pvmbg-token
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
BMKG_EVENT_INTERVAL_MS=10000
PVMBG_EVENT_INTERVAL_MS=10000
BMKG_URL=http://bmkg:8081
PVMBG_URL=http://pvmbg:8082
AGGREGATOR_API_KEY=replace-with-aggregator-api-key
AGGREGATOR_LISTEN_ADDRESS=:8083
AGGREGATOR_URL=http://aggregator:8083
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=hazard.events.v1
DASHBOARD_CONSUMER_GROUP=dashboard-updater-v1
DASHBOARD_LISTEN_ADDRESS=:8085
DASHBOARD_STORE_PATH=/data/dashboard.db
NOTIFIER_CONSUMER_GROUP=field-notifier-v1
NOTIFIER_LISTEN_ADDRESS=:8086
NOTIFIER_STORE_PATH=/data/notifier.db
AGGREGATOR_POLL_INTERVAL_MS=5000
AGGREGATOR_HTTP_TIMEOUT_MS=4000
AGGREGATOR_MAX_IN_FLIGHT=64
AGGREGATOR_START_SINCE=1970-01-01T00:00:00Z
CLIENT_API_MAX_IN_FLIGHT=64
POSTGRES_ADMIN_PASSWORD=replace-with-postgres-admin-password
POSTGRES_APP_USER=aggregator_app
POSTGRES_APP_PASSWORD=replace-with-aggregator-app-password
DATABASE_URL=postgres://aggregator_app:replace-with-aggregator-app-password@postgres:5432/aggregator?sslmode=disable
AUTH_POSTGRES_PASSWORD=replace-with-auth-postgres-password
AUTH_DATABASE_URL=postgres://auth_app:replace-with-auth-postgres-password@auth-postgres:5432/auth?sslmode=disable
AUTH_LISTEN_ADDRESS=:8084
AUTH_JWKS_URL=http://auth:8084/.well-known/jwks.json
AUTH_ACCESS_TOKEN_TTL_SECONDS=60
AUTH_REFRESH_TOKEN_TTL_SECONDS=86400
AUTH_MAX_IN_FLIGHT=32
AUTH_JWT_ISSUER=bnpb-auth-service
AUTH_JWT_AUDIENCE=bnpb-client-api
AUTH_JWT_KEY_ID=bnpb-auth-2026-01
AUTH_JWT_PRIVATE_KEY_B64=replace-with-base64-pem-rsa-private-key
MEDIA_CLIENT_ID=media-client
MEDIA_CLIENT_SECRET=replace-with-unique-media-secret
FIELD_CLIENT_ID=field-client
FIELD_CLIENT_SECRET=replace-with-unique-field-secret
OPS_CLIENT_ID=ops-client
OPS_CLIENT_SECRET=replace-with-unique-ops-secret
