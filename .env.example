BMKG_API_KEY=replace-with-bmkg-api-key
PVMBG_TOKEN=replace-with-pvmbg-token
PVMBG_DELAY_MIN_MS=500
PVMBG_DELAY_MAX_MS=3000
BMKG_EVENT_INTERVAL_MS=10000
PVMBG_EVENT_INTERVAL_MS=10000
BMKG_URL=http://bmkg:8081
PVMBG_URL=http://pvmbg:8082
AGGREGATOR_API_KEY=replace-with-aggregator-api-key
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=hazard.events.v1
AGGREGATOR_POLL_INTERVAL_MS=5000
AGGREGATOR_HTTP_TIMEOUT_MS=4000
AGGREGATOR_START_SINCE=1970-01-01T00:00:00Z
POSTGRES_ADMIN_PASSWORD=replace-with-postgres-admin-password
POSTGRES_APP_USER=aggregator_app
POSTGRES_APP_PASSWORD=replace-with-aggregator-app-password
DATABASE_URL=postgres://aggregator_app:replace-with-aggregator-app-password@postgres:5432/aggregator?sslmode=disable
