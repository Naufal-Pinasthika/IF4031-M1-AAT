AGGREGATOR_RESPONSE_SLOTS=128
AGGREGATOR_SHARED_READ_PROJECTION=true
AGGREGATOR_FIELD_RESERVED_SLOTS=16
AGGREGATOR_READ_CACHE_TTL_MS=100
